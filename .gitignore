# Local data and credentials
# Leading slash: only the top-level data folder, not docs/data/.
# Everything in data/ stays local except data/source/: the fictional data-v1
# inputs, committed so a fresh clone runs end to end (until DVC is set up).
/data/*
!/data/source/
# The held-out classifier test set is committed too, except the writers'
# drafts and the pipeline output made when checking it.
!/data/eval/
/data/eval/*/work/
/data/eval/*/processed/
secrets/
.env

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.idea/
.vscode/
