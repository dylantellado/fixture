# Copy to .env at the repo root and fill in values. Never commit .env.
API_HOST=0.0.0.0
API_PORT=8000

# Web app (src/frontend). Each person generates their own values.

# Signs the browser session cookie. Changing it signs everyone out.
# Generate from src/frontend: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Encrypts stored Google credentials in data/fixture.db. Changing it means
# everyone has to sign in again (old records can't be decrypted).
# Generate from src/frontend: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
