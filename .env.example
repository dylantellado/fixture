# Copy to .env at the repo root and fill in values. Never commit .env.
API_HOST=0.0.0.0
API_PORT=8000

# Web app (src/frontend). Each person generates their own values.

# Signs the browser session cookie. Changing it signs everyone out.
# Generate from src/frontend: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Encrypts stored Google credentials in data/fixture.db. Changing it means
# everyone has to sign in again (old records can't be decrypted).
# Generate from src/frontend: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Which classifier the dashboard uses to label emails. Pick one:
#   Local (default): leave CLASSIFIER_URL unset. The web app then uses
#     http://localhost:8002 with `uv run` and http://classifier:8002 in Docker Compose.
#   Cloud Run: uncomment the line below. Run `gcloud auth application-default login` once;
#     the web app sends a Google ID token from those credentials with every request, and your
#     account needs roles/run.invoker on the service (project owners have it). Works with
#     `uv run` and Docker Compose (which mounts ~/.config/gcloud read-only).
# CLASSIFIER_URL=https://fixture-classifier-622192804476.us-east1.run.app
