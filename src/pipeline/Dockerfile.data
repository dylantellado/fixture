# Image for the pipeline's data steps (assemble, ingest, preprocess). Built by
# run_pipeline.sh from a folder that mirrors the repo: /app/src/{generate,ingest,preprocess},
# each with its own locked virtualenv, run with `uv run --no-sync --directory ...`.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PYTHONUNBUFFERED=1
COPY src /app/src
RUN for s in generate ingest preprocess; do uv sync --locked --no-dev --directory /app/src/$s; done
WORKDIR /app
